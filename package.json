{
  "name": "echo-health-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "dev": "node --watch server/src/main.ts",
    "test": "node --test tests/*.test.ts",
    "wr:dev": "npm --prefix apps/waiting-room run dev",
    "wr:test": "npm --prefix apps/waiting-room run test",
